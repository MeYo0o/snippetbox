package components

templ Login(form UserLoginForm, templateData TemplateData) {
	@Base("Login", loginBody(form, templateData.CSRFToken), templateData)
}

templ loginBody(form UserLoginForm, csrfToken string) {
	<form action="/user/login" method="POST" novalidate>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		for _, err := range form.NonFieldErrors {
			<div class="error">{ err }</div>
		}
		<div>
			<label>Email:</label>
			if emailErr, ok:= form.FieldErrors["email"];ok {
				<label class="error">{ emailErr }</label>
			}
			<input type="email" name="email" value={ form.Email }/>
		</div>
		<div>
			<label>Password:</label>
			if passwordErr, ok:= form.FieldErrors["password"];ok {
				<label class="error">{ passwordErr }</label>
			}
			<input type="password" name="password"/>
		</div>
		<div>
			<input type="submit" value="login"/>
		</div>
	</form>
}
