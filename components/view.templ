package components

import (
	"fmt"
	"snippetbox.innolabs.ai/internal/models"
)

templ ViewSnippet(snippet models.Snippet) {
	@Base(fmt.Sprint("Snippet #", snippet.ID), SnippetBody(snippet))
}

templ SnippetBody(snippet models.Snippet) {
	<div class="snippet">
		<div class="metadata">
			<strong>{ snippet.Title }</strong>
			<span>#{ snippet.ID }</span>
		</div>
		<pre><code>{ snippet.Content }</code></pre>
		<div class="metadata">
			<time>Created: { formateDate(snippet.Created) }</time>
			<time>Expires: { formateDate(snippet.Expires) }</time>
		</div>
	</div>
}
